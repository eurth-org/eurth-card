---
// The card maker, and under it what newcomers and search engines both want: what it is, how to
// use it, and answers to the usual questions (also given to search engines as structured data).
import { faqPage, webApplication } from '@eurth/style/build';
import Page from '@eurth/style/components/Page.astro';
import { site } from '../../eurth.config.mjs';
import { EXAMPLES } from '../card/examples.ts';
import { readCard } from '../card/read.ts';
import { cardThemes, sectionTools } from '../site/build.ts';
import Card from '../tool/Card.svelte';

// The card on the table before the visitor brings their own. Only the card's data goes to the
// browser, never the example profile itself.
const sample = readCard(EXAMPLES.find((example) => example.id === 'teland')?.profile);

const faq = [
  {
    q: 'Is Card free?',
    a: 'Yes. There is no account, no watermark and no paid tier. It is made by the Eurth worldbuilding community for anyone who needs it.',
  },
  {
    q: 'Where is my card saved?',
    a: 'In its link, its picture and your profile file. The link holds the whole card, so copying the link is saving it. Nothing is kept in your browser or on a server.',
  },
  {
    q: 'What is a profile file?',
    a: 'One small file, named after your nation and ending in .eurth.json, that every Eurth tool can read and add to. Each tool fills in its own part: a flag, a government, the numbers. Card reads them all and puts them on one card.',
  },
  {
    q: 'What if my profile is nearly empty?',
    a: 'The card shows whatever is there, and looks finished at every stage: a name alone makes a card. The list beside it says which parts are missing, and you can type a name, a capital and a motto here.',
  },
  {
    q: 'Why does the card not carry the Eurth logo?',
    a: 'Because it belongs to your world, not to ours. A fact card is something your nation might print itself, so it carries only the line card.eurth.org.',
  },
  {
    q: 'Does it work offline, and on a phone?',
    a: 'Yes to both. After the first visit the site keeps a copy of itself on your device and opens without a connection.',
  },
];
---

<Page
  site={site}
  jsonld={[
    webApplication(site, {
      featureList: [
        'Country fact cards from a nation profile',
        'Six picture sizes, as PNG and WebP',
        'Three layouts and two colour themes',
        'A link that holds the whole card',
        'A written description of every card',
      ],
    }),
    faqPage(faq),
  ]}
>
  <div class="eu-stack">
    <header class="eu-stack intro">
      <p class="eu-kicker">Country fact card</p>
      <h1>Everything about your nation, on one card</h1>
      <p class="eu-lead">Load your nation's profile and get its flag, arms, key facts, parliament and history on one card to share. Free, in your browser, no account needed.</p>
    </header>

    <!-- client:load draws the tool as real HTML first, then wakes it up. -->
    <Card client:load siteName={site.name} siteUrl={site.url} themes={cardThemes()} tools={sectionTools(site.host)} sample={sample} />

    <section class="eu-prose">
      <h2>How it works</h2>
      <ol>
        <li>Press Load profile and pick your nation's file, or drop it anywhere on the page. No profile yet? Type a name, a capital and a motto, and that is a card already.</li>
        <li>Choose a format for where the card is going, one of three layouts, and Night or Light.</li>
        <li>Download the picture, or copy the link, the picture or the description. The link holds the whole card.</li>
      </ol>
      <p>
        The <a href="/guide/">guide</a> explains how to fill a profile, the <a href="/glossary/">glossary</a> has the words, and the
        <a href="/examples/">examples</a> show cards at every stage, from a name alone to a nation with everything.
      </p>

      <h2>Questions</h2>
      <dl>
        {
          faq.map((item) => (
            <>
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </>
          ))
        }
      </dl>
    </section>
  </div>

  <Fragment slot="inspirations">Card takes after the fact boxes of encyclopaedias and almanacs, and the cards children trade about everything else.</Fragment>
</Page>

<style>
  .intro {
    gap: var(--space-2);
  }
</style>
