---
// Examples: ready-made cards, each a link into the maker. The links and pictures are made at
// build time with the same code the maker uses, so they can never drift apart. Only cards are
// shown here, never the example profiles themselves: those carry the addresses of other tools.
import Page from '@eurth/style/components/Page.astro';
import { site } from '../../eurth.config.mjs';
import { describe } from '../card/describe.ts';
import { EXAMPLES } from '../card/examples.ts';
import { layout } from '../card/layout.ts';
import { cardLink } from '../card/link.ts';
import { SECTIONS } from '../card/model.ts';
import { readCard } from '../card/read.ts';
import { dataAddress, render } from '../card/render.ts';
import { cardThemes } from '../site/build.ts';

const themes = cardThemes();
const cards = await Promise.all(
  EXAMPLES.map(async (example, index) => {
    const data = readCard(example.profile);
    // Alternate the themes, so the page shows both.
    const theme = index % 2 === 0 ? 'night' : 'light';
    const link = await cardLink({ data, format: 'preview', layout: 'classic', theme }, 'https://card.eurth.org/');
    return {
      ...example,
      href: `/${new URL(link.url).search}`,
      picture: dataAddress(render(layout(data, { format: 'preview', layout: 'classic' }), data, themes[theme])),
      alt: describe(data),
      filled: data.filled.length,
    };
  }),
);
---

<Page
  site={site}
  title="Example country fact cards"
  description="Four invented nations as fact cards, from a name alone to a kingdom with every section filled. Open one in Card to see how a card grows with its profile."
  crumbs={[{ name: 'Examples', path: '/examples/' }]}
>
  <div class="eu-stack">
    <header class="eu-prose">
      <p class="eu-kicker">Examples</p>
      <h1>Example country fact cards</h1>
      <p class="eu-lead">
        Four invented nations, from a name alone to a kingdom with everything. Open one in the <a href="/">card maker</a> to try the formats and layouts; the
        <a href="/guide/">guide</a> says how each part of a profile gets filled.
      </p>
    </header>
    <ul class="gallery">
      {
        cards.map((card) => (
          <li>
            <a class="eu-card" href={card.href}>
              <img src={card.picture} alt={card.alt} width="1200" height="630" loading="lazy" />
              <h2>{card.name}</h2>
              <p>{card.about}</p>
              <p class="eu-muted">
                {card.filled} of {SECTIONS.length} sections filled.
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Page>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery img {
    display: block;
    width: 100%;
    height: auto;
  }

  .gallery h2 {
    font: var(--type-heading);
  }
</style>
